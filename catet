#!/bin/bash
set -euo pipefail
APP="/Applications/Catet.app"
if [[ ! -x "$APP/Contents/MacOS/CatetEngine" ]]; then
  echo 'Run ./setup.sh or ./install.sh first.' >&2
  exit 1
fi
if [[ "${1:-}" == "open" ]]; then
  exec open "$APP"
fi
if [[ "${1:-}" == "permissions" ]]; then
  exec open -a "$APP" 'catet://permissions'
fi
exec "$APP/Contents/MacOS/CatetEngine" "$@"
